<div>
  <ul>
    <li><%= link_to "戻る", request.referer %></li>
  </ul>
</div>

<table>
  <tr>
    <th>施設名</th>
    <td><%= @room.name %></td>
  </tr>
  <tr>
    <th>料金</th>
    <td><%= @room.price_per_night %> 円</td>
  </tr>
  <tr>
    <th>住所</th>
    <td><%= @room.address %></td>
  </tr>
  <tr>
    <th>施設詳細</th>
    <td><%= @room.introduction %></td>
  </tr>
  <tr>
    <td>
      <% if @room.image.attached? %>
        <%= image_tag @room.image, size: "150x150" %>
      <% else %>
        <%= image_tag "default-image.png", size: "150x150" %>
      <% end %>
    </td>
  </tr>
</table>

<li><%= link_to "予約する", new_reservation_path(room_id: @room.id) %></li>
