<h3>登録済み一覧</h3>

<table class="rooms-table">
  <thead>
    <tr>
      <th>id</th>
      <th>施設名</th>
      <th>施設詳細</th>
      <th>料金</th>
      <th>作成日</th>
    </tr>
  </thead>

  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td><%= room.id %></td>
        <td>
          <% if room.image.attached? %>
            <%= image_tag room.image, size: "150x150" %>
          <% else %>
            <%= image_tag "default-image.png", size: "150x150" %>
          <% end %>
        </td>
        <td><%= link_to room.name, room_path(room) %></td>
        <td><%= room.introduction %></td>
        <td><%= room.price_per_night %> 円</td>
        <td><%= room.created_at.strftime('%Y/%m/%d') %></td>
        <td><%= link_to "編集", [:edit, room] %></td>
        <td><%= link_to "削除", room, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

