<h3>施設情報の編集</h3>

<%= form_with model: @room do |f| %>
  <table>
    <tr>
      <th><%= f.label :name ,"施設名 *" %></th>
      <td><%= f.text_field :name %></td>
    </tr>
    <tr>
      <th><%= f.label :introduction ,"施設詳細 *" %></th>
      <td><%= f.text_area :introduction %></td>
    </tr>
    <tr>
      <th><%= f.label :price_per_night ,"料金 *" %></th>
      <td><%= f.number_field :price_per_night %> 円</td>
    </tr>
    <tr>
      <th><%= f.label :address ,"住所 *" %></th>
      <td><%= f.text_field :address %></td>
    </tr>
    <tr>
      <th><%= f.label :image ,"施設画像" %></th>
      <td>
        <% if @room.image.present? %>
          <%= image_tag room.image, size: "150x150" %>
        <% else %>
          <%= image_tag "default-image.png", size: "150x150" %>
        <% end %>
        <%= f.file_field :image %>
      </td>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "保存" %></li>
      <li><%= link_to "キャンセル", rooms_own_path %></li>
    </ul>
  </div>
<% end %>
