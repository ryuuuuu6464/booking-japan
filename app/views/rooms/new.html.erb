<h3>新規登録</h3>

<%= render "shared/error", obj: @room %>

<%= form_with model: @room, url: rooms_path, local: true, html: { multipart: true } do |f| %>
  <table>
    <table>
    <tr>
      <th><%= f.label :name ,"施設名 *" %></th>
      <td><%= f.text_field :name %></td>
    </tr>

    <tr>
      <th><%= f.label :introduction ,"施設詳細 *" %></th>
      <td><%= f.text_area :introduction %></td>
    </tr>

    <tr>
      <th><%= f.label :price_per_night ,"料金 *" %></th>
      <td><%= f.number_field :price_per_night %> 円></td>
    </tr>

    <tr>
      <th><%= f.label :address ,"住所 *" %></th>
      <td><%= f.text_field :address %></td>
    </tr>

    <tr>
      <th><%= f.label :image ,"施設画像" %></th>
      <td><%= f.file_field :image %></td>
    </tr>
  </table>

  <div>
    <ul>
      <li><%= f.submit "保存" %></li>
      <li><%= link_to "キャンセル", rooms_path %></li>
    </ul>
  </div>
<% end %>
