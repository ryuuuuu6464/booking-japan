<% if flash[:notice] %>
  <p class="notice"><%= flash[:notice] %></p>
<% end %>

<p>Booking Japanで</p>
<p>まだ体験したことのない</p>
<p>旅をしよう</p>

<%= form_with url: rooms_path, method: :get, local: true do |f| %>
  <div>
    <%= f.label :area, "エリア名を入力" %>
    <%= f.text_field :area, value: @area %>
  </div>

  <div>
    <%= f.submit "検索" %>
  </div>
<% end %>

<h3>おすすめのエリア</h3>

<%= link_to "東京", rooms_path(area: "東京") %>
<%= link_to "京都", rooms_path(area: "京都") %>
<%= link_to "大阪", rooms_path(area: "大阪") %>
<%= link_to "札幌", rooms_path(area: "札幌") %>
